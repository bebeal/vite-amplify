{
  "name": "vite-amplify",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/bebeal/vite-amplify"
  },
  "bugs": {
    "url": "https://github.com/bebeal/vite-amplify/issues"
  },
  "scripts": {
    "build": "yarn build:client && yarn build:server && yarn postbuild",
    "build:client": "tsc && vite build",
    "build:server": "tsc -p tsconfig.node.json ",
    "clean": "rimraf dist node_modules yarn.lock .amplify-hosting",
    "dev": "nodemon --watch server --exec tsx server",
    "format": "prettier --write src server.ts api",
    "lint": "yarn eslint src server.ts api --report-unused-disable-directives --max-warnings 0",
    "postbuild": "chmod +x postbuild.sh && ./postbuild.sh",
    "serve": "node dist/server/server.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.62.0",
    "express": "^4.21.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.5.0",
    "react-tweet": "^3.2.2"
  },
  "devDependencies": {
    "@bebeal/console-prefix-plugin": "^0.1.3",
    "@eslint/js": "^9.24.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.3",
    "@types/compression": "^1.7.5",
    "@types/eslint": "^9.6.1",
    "@types/eslint__js": "^9.14.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@types/source-map-support": "^0.5.10",
    "@vitejs/plugin-react": "^4.3.4",
    "compression": "^1.8.0",
    "constructs": "^10.4.2",
    "dotenv": "^16.4.7",
    "eslint": "9.24.0",
    "next-themes": "^0.4.6",
    "nodemon": "^3.1.9",
    "prettier": "3.5.3",
    "rimraf": "^6.0.1",
    "serve-static": "^1.16.2",
    "source-map-support": "^0.5.21",
    "tailwindcss": "^4.1.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.29.0",
    "vite": "^6.2.6",
    "vite-plugin-svgr": "^4.3.0"
  },
  "engines": {
    "node": ">=20",
    "yarn": ">=4",
    "npm": ">=9"
  },
  "packageManager": "yarn@4.9.1"
}
